{
    "name": "daignosislab/emr-voice",
    "description": "Live audio capture, voice-activity-detection chunking and upload to the dAIgnosisLab EMR pipeline, for Laravel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-ffi": "*",
        "ankane/onnxruntime": "^0.2",
        "guzzlehttp/psr7": "^2.0",
        "illuminate/bus": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "psr/log": "^2.0|^3.0",
        "ratchet/rfc6455": "^0.3.1|^0.4",
        "react/event-loop": "^1.5",
        "react/http": "^1.9",
        "react/promise": "^3.0",
        "react/socket": "^1.14"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "ext-pcntl": "Graceful restarts of emr-voice:serve on SIGTERM"
    },
    "autoload": {
        "psr-4": {
            "EmrVoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EmrVoice\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EmrVoice\\EmrVoiceServiceProvider"
            ],
            "aliases": {
                "EmrVoice": "EmrVoice\\Facades\\EmrVoice"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
