{
    "name": "daignosislab/vad-chunker",
    "description": "Voice activity detection (Silero VAD) that cuts a live or recorded 16 kHz audio stream into speech chunks at natural pauses. Plain PHP, with Laravel integration.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "vad",
        "voice activity detection",
        "silero",
        "audio",
        "speech",
        "chunking",
        "laravel"
    ],
    "require": {
        "php": "^8.1",
        "ext-ffi": "*",
        "ankane/onnxruntime": "^0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "illuminate/support": "Laravel integration: facade, config, vad-chunker:install-runtime and vad-chunker:doctor"
    },
    "autoload": {
        "psr-4": {
            "VadChunker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VadChunker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VadChunker\\VadChunkerServiceProvider"
            ],
            "aliases": {
                "VadChunker": "VadChunker\\Facades\\VadChunker"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "bin": [
        "bin/vad-chunker"
    ]
}
